	"youkaishomecoming.spell_editor.help.title": "符卡编辑器帮助",
	"youkaishomecoming.spell_editor.help.line.0": "\u00A7e\u00A7l--- 快捷键 ---",
	"youkaishomecoming.spell_editor.help.line.1": "",
	"youkaishomecoming.spell_editor.help.line.2": "\u00A7fSpace       \u00A77播放/暂停",
	"youkaishomecoming.spell_editor.help.line.3": "\u00A7fR           \u00A77重置到 tick 0",
	"youkaishomecoming.spell_editor.help.line.4": "\u00A7fRight       \u00A77单步推进 1 tick",
	"youkaishomecoming.spell_editor.help.line.5": "\u00A7fDel/Bksp    \u00A77删除选中节点",
	"youkaishomecoming.spell_editor.help.line.6": "",
	"youkaishomecoming.spell_editor.help.line.7": "\u00A7fCtrl+Z      \u00A77撤销",
	"youkaishomecoming.spell_editor.help.line.8": "\u00A7fCtrl+Y      \u00A77重做",
	"youkaishomecoming.spell_editor.help.line.9": "\u00A7fCtrl+C      \u00A77复制节点",
	"youkaishomecoming.spell_editor.help.line.10": "\u00A7fCtrl+X     \u00A77剪切节点",
	"youkaishomecoming.spell_editor.help.line.11": "\u00A7fCtrl+V     \u00A77粘贴节点",
	"youkaishomecoming.spell_editor.help.line.12": "\u00A7fCtrl+Up    \u00A77上移节点",
	"youkaishomecoming.spell_editor.help.line.13": "\u00A7fCtrl+Down  \u00A77下移节点",
	"youkaishomecoming.spell_editor.help.line.14": "\u00A7fCtrl+D     \u00A77启用/禁用节点",
	"youkaishomecoming.spell_editor.help.line.15": "\u00A7fCtrl+E     \u00A77折叠/展开选中子树",
	"youkaishomecoming.spell_editor.help.line.16": "\u00A7fCtrl+Sh+E  \u00A77全部折叠/全部展开",
	"youkaishomecoming.spell_editor.help.line.17": "\u00A7fCtrl+N     \u00A77切换自定义节点名显示",
	"youkaishomecoming.spell_editor.help.line.18": "\u00A7fCtrl+B     \u00A77切换 +按钮 全部显示/仅选中显示",
	"youkaishomecoming.spell_editor.help.line.19": "",
	"youkaishomecoming.spell_editor.help.line.20": "\u00A7e\u00A7l--- 鼠标操作 ---",
	"youkaishomecoming.spell_editor.help.line.21": "",
	"youkaishomecoming.spell_editor.help.line.22": "\u00A76节点树:",
	"youkaishomecoming.spell_editor.help.line.23": "\u00A7f  单击节点    \u00A77选中并在右侧编辑（显示该节点的 + 按钮）",
	"youkaishomecoming.spell_editor.help.line.24": "\u00A7f  双击节点    \u00A77重命名 (Enter 确认, Esc 取消)",
	"youkaishomecoming.spell_editor.help.line.25": "\u00A7f  点击 \u25BC/\u25B6   \u00A77折叠/展开子树",
	"youkaishomecoming.spell_editor.help.line.26": "\u00A7f  拖拽节点    \u00A77拖放重排序或移入分支",
	"youkaishomecoming.spell_editor.help.line.27": "\u00A7f  点击 [+]   \u00A77添加新节点到段落/分支",
	"youkaishomecoming.spell_editor.help.line.28": "",
	"youkaishomecoming.spell_editor.help.line.29": "\u00A76属性面板:",
	"youkaishomecoming.spell_editor.help.line.30": "\u00A7f  [Disable]  \u00A77禁用节点（运行时跳过）",
	"youkaishomecoming.spell_editor.help.line.31": "\u00A7f  [Delete]   \u00A77删除节点",
	"youkaishomecoming.spell_editor.help.line.32": "\u00A7f  Ctrl+点击 \u00A7b$var\u00A7f  \u00A77跳转到变量定义节点",
	"youkaishomecoming.spell_editor.help.line.33": "\u00A7f  Tab        \u00A77表达式自动补全",
	"youkaishomecoming.spell_editor.help.line.34": "\u00A7f  滚轮       \u00A77滚动属性列表（可拖拽滚动条）",
	"youkaishomecoming.spell_editor.help.line.35": "",
	"youkaishomecoming.spell_editor.help.line.36": "\u00A763D 视口（正交模式）:",
	"youkaishomecoming.spell_editor.help.line.37": "\u00A7f  左键拖拽    \u00A77移动目标位置",
	"youkaishomecoming.spell_editor.help.line.38": "\u00A7f  中键拖拽    \u00A77沿视角平面平移摄像机",
	"youkaishomecoming.spell_editor.help.line.39": "\u00A7f  右键拖拽    \u00A77旋转摄像机",
	"youkaishomecoming.spell_editor.help.line.40": "\u00A7f  滚轮        \u00A77缩放",
	"youkaishomecoming.spell_editor.help.line.41": "",
	"youkaishomecoming.spell_editor.help.line.42": "\u00A763D 视口（透视模式）:",
	"youkaishomecoming.spell_editor.help.line.43": "\u00A7f  左键单击    \u00A77进入自由视角（隐藏鼠标）",
	"youkaishomecoming.spell_editor.help.line.44": "\u00A7f  WASD/空格/Shift  \u00A77移动摄像机（自由视角中）",
	"youkaishomecoming.spell_editor.help.line.45": "\u00A7f  鼠标移动    \u00A77旋转视角（自由视角中）",
	"youkaishomecoming.spell_editor.help.line.46": "\u00A7f  滚轮        \u00A77调节飞行速度",
	"youkaishomecoming.spell_editor.help.line.47": "\u00A7f  右键拖拽    \u00A77轴心旋转（环绕前方中心）",
	"youkaishomecoming.spell_editor.help.line.48": "\u00A7f  中键拖拽    \u00A77视角平面平移",
	"youkaishomecoming.spell_editor.help.line.49": "\u00A7f  Esc         \u00A77退出自由视角 / 退出透视模式",
	"youkaishomecoming.spell_editor.help.line.50": "",
	"youkaishomecoming.spell_editor.help.line.51": "\u00A7e\u00A7l--- 工具栏按钮 ---",
	"youkaishomecoming.spell_editor.help.line.52": "",
	"youkaishomecoming.spell_editor.help.line.53": "\u00A7fTop/Front/Side    \u00A77切换正交预设角度",
	"youkaishomecoming.spell_editor.help.line.54": "\u00A7fPersp/Ortho       \u00A77切换透视/正交模式",
	"youkaishomecoming.spell_editor.help.line.55": "\u00A7fBindTgt/Unbind    \u00A77绑定/解绑目标跟随摄像机（透视）",
	"youkaishomecoming.spell_editor.help.line.56": "\u00A7f\u25B6All / \u25BCAll       \u00A77全部折叠 / 全部展开节点树",
	"youkaishomecoming.spell_editor.help.line.57": "\u00A7f[+]:Sel/All       \u00A77+ 按钮 仅选中显示 / 全部显示",
	"youkaishomecoming.spell_editor.help.line.58": "\u00A7fApply             \u00A77应用并保存符卡到所有使用它的实体",
	"youkaishomecoming.spell_editor.help.line.59": "\u00A7fExport            \u00A77导出 JSON 到 youkaishomecoming_exports/",
	"youkaishomecoming.spell_editor.help.line.60": "\u00A7fReset             \u00A77恢复到内建默认值",
	"youkaishomecoming.spell_editor.help.line.61": "\u00A7fAuto:ON/OFF       \u00A77编辑后自动回放预览",
	"youkaishomecoming.spell_editor.help.line.62": "\u00A7fFocusTgt/Cstr     \u00A77将视口居中到目标/施法者",
	"youkaishomecoming.spell_editor.help.line.63": "\u00A7fRstTgtPos/CstrPos \u00A77重置目标/施法者到默认位置",
	"youkaishomecoming.spell_editor.help.line.64": "",
	"youkaishomecoming.spell_editor.help.line.65": "\u00A7e\u00A7l--- Mover 类型 ---",
	"youkaishomecoming.spell_editor.help.line.66": "",
	"youkaishomecoming.spell_editor.help.line.67": "\u00A7fnone              \u00A77默认直线飞行",
	"youkaishomecoming.spell_editor.help.line.68": "\u00A7facceleration      \u00A77恒定加速度",
	"youkaishomecoming.spell_editor.help.line.69": "\u00A7frotate            \u00A77旋转",
	"youkaishomecoming.spell_editor.help.line.70": "\u00A7fpolar             \u00A77极坐标运动",
	"youkaishomecoming.spell_editor.help.line.71": "\u00A7fzero              \u00A77静止不动",
	"youkaishomecoming.spell_editor.help.line.72": "\u00A7fbezier            \u00A77三次贝塞尔曲线路径",
	"youkaishomecoming.spell_editor.help.line.73": "",
	"youkaishomecoming.spell_editor.help.line.74": "\u00A7e\u00A7l--- 表达式语法 ---",
	"youkaishomecoming.spell_editor.help.line.75": "",
	"youkaishomecoming.spell_editor.help.line.76": "\u00A77运算符: \u00A7f+ - * / %  \u00A77括号: \u00A7f( )",
	"youkaishomecoming.spell_editor.help.line.77": "\u00A77变量: \u00A7b$wave  $i  $ver",
	"youkaishomecoming.spell_editor.help.line.78": "\u00A77函数: \u00A7erand\u00A7f(min,max)  \u00A7esqrt\u00A7f(x)",
	"youkaishomecoming.spell_editor.help.line.79": "\u00A77\u4E09\u89D2: \u00A7esin_deg/cos_deg\u00A7f(x)  \u00A7esin_rad/cos_rad\u00A7f(x)",
	"youkaishomecoming.spell_editor.help.line.80": "\u00A77       \u00A7elerp\u00A7f(start,end,dur)",
	"youkaishomecoming.spell_editor.help.line.81": "\u00A77       \u00A7ehp\u00A7f(full,empty)  \u00A7etick_mod\u00A7f(n)",
	"youkaishomecoming.spell_editor.help.line.82": "\u00A77关键字: \u00A7etick  total_tick  distance",
	"youkaishomecoming.spell_editor.help.line.83": "",
	"youkaishomecoming.spell_editor.help.line.84": "\u00A7e\u00A7l--- 语法高亮 ---",
	"youkaishomecoming.spell_editor.help.line.85": "",
	"youkaishomecoming.spell_editor.help.line.86": "\u00A7b$variable        \u00A77浅蓝色",
	"youkaishomecoming.spell_editor.help.line.87": "\u00A7erand() sqrt()    \u00A77函数 = 黄色",
	"youkaishomecoming.spell_editor.help.line.88": "\u00A7etick distance    \u00A77关键字 = 黄色",
	"youkaishomecoming.spell_editor.help.line.89": "\u00A7e(  \u00A7c(  \u00A7a(  \u00A79(  \u00A77括号 = 彩虹（仅合法时）"
}
